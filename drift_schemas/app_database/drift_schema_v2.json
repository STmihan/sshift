    {
      "name": "shift_templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shift_templates\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"all_day\" INTEGER NOT NULL CHECK (\"all_day\" IN (0, 1)), \"start_minute\" INTEGER NOT NULL, \"end_minute\" INTEGER NOT NULL, \"break_minutes\" INTEGER NOT NULL, \"pay_type\" INTEGER NOT NULL, \"pay_amount\" INTEGER NOT NULL, \"location\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
