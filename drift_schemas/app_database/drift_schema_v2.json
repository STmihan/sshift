      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shifts\" (\"id\" TEXT NOT NULL, \"template_id\" TEXT NOT NULL, \"day\" INTEGER NOT NULL, \"all_day\" INTEGER NOT NULL CHECK (\"all_day\" IN (0, 1)), \"start_minute\" INTEGER NOT NULL, \"end_minute\" INTEGER NOT NULL, \"break_minutes\" INTEGER NOT NULL, \"notes\" TEXT NOT NULL, \"location\" TEXT NOT NULL, \"pay_type\" INTEGER NOT NULL, \"pay_amount\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
